# Admin panel girisi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir-bu-sifreyi
SESSION_SECRET=rastgele-uzun-bir-metin-buraya

# Sunucu
PORT=3000

# Telegram Bot (https://t.me/BotFather uzerinden /newbot ile alinir)
TELEGRAM_BOT_TOKEN=

# Panelin yayindaki adresi (Railway domaininiz). Telegram botuna /info
# yazildiginda bu adres gonderilir. Opsiyonel ama onerilir.
PUBLIC_BASE_URL=

# SharedMind baglantisi (istege bagli). En az 32 karakter, rastgele.
# SharedMind'da MESSAGE_BOT_TOKEN ayni deger olur. Bos ise servis girisi kapali.
SERVICE_TOKEN=
